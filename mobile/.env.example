# Your computer's LAN IP running the backend (phones can't reach "localhost").
# Leave unset in Expo Go: the app derives it from the Metro host automatically.
EXPO_PUBLIC_API_URL=http://192.168.1.50:8000

# Google sign-in (optional). Native IDs are needed for the installed app; Expo Go can't do Google sign-in.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
